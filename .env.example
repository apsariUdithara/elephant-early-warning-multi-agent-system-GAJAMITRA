# Copy to .env (git-ignored) and fill in. Never commit real values.

# Meta Model API (SAM 3.1, Muse Spark, Muse Wonder)
MODEL_API_KEY=

# docker-compose.yml
POSTGRES_DB=gajamitra
POSTGRES_USER=gajamitra
POSTGRES_PASSWORD=
# Backend: defaults to jdbc:postgresql://localhost:5432/gajamitra (docker compose); set for other databases
# DATABASE_URL=
RABBITMQ_DEFAULT_USER=gajamitra
RABBITMQ_DEFAULT_PASS=

# Added in later phases (see docs/IMPLEMENTATION_PLAN.md)
# MCP_API_KEY=              Phase 3: shared key between ai-service and the Spring MCP endpoint
# GAJAMITRA_ADMIN_USERNAME= First dashboard admin, created only while there are no users
# GAJAMITRA_ADMIN_PASSWORD= (12+ characters; remove both once the admin exists)
# GAJAMITRA_SECURE_COOKIES=true  false only for plain-HTTP local runs
# GAJAMITRA_VIDEO_DIR=      Uploaded clips (default data/videos); must be shared with ai-service
# GAJAMITRA_SMS_ENABLED=false  true: real SMS through Twilio (the three TWILIO_ values are then required)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# LANGFUSE_PUBLIC_KEY=      Phase 2: agent tracing
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
