# The web door: the built React dashboard served by Caddy (plan Phase 7). Built from the repo root:
#   docker build -f deploy/Dockerfile.web -t gajamitra-web .
FROM node:22 AS build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/frontend/dist /srv
